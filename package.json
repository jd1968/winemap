{
  "name": "winemap",
  "version": "1.0.0",
  "description": "Interactive world map of wine regions and famous wines",
  "main": "server/index.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "db:local:init": "sh scripts/init-postgres.sh",
    "db:local:start": "sh scripts/start-postgres.sh",
    "db:local:stop": "sh scripts/stop-postgres.sh",
    "db:create": "node scripts/createDatabase.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:local:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "db:init": "npm run db:local:init",
    "db:start": "npm run db:local:start",
    "db:stop": "npm run db:local:stop",
    "db:setup": "npm run db:local:setup",
    "storage:migrate": "node scripts/migrateUploadsToSupabase.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "dev": "npm run db:local:start && concurrently \"npm run server\" \"npm run client\"",
    "dev:hosted-db": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "openai": "^7.5.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
